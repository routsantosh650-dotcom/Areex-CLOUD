# ============================================================
# AREEX CLOUD - ENVIRONMENT VARIABLES
# ============================================================

# Gemini
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application URL
APP_URL="https://areexcloud.site"

# ============================================================
# RAZORPAY
# ============================================================

# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID="rzp_live_YOUR_NEW_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_NEW_RAZORPAY_SECRET"

# Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# ============================================================
# AES SECURITY
# ============================================================

AES_MASTER_KEY="GENERATE_A_LONG_RANDOM_32_BYTE_SECRET"

# ============================================================
# SERVER
# ============================================================

NODE_ENV="production"
PORT="3000"
